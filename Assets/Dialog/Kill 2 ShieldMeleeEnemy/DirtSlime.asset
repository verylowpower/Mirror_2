  m_Script: {fileID: 11500000, guid: de3a755748fe6b74f9cd3eb850d7aa7c, type: 3}
  m_Name: DirtSlime
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  sentences:
  - "So\u2026 you have made it beyond the forest.\nThis place is very different from
    the woods you once walked through.\nLong ago, this land was not a desert.\nBut
    time, war, and forgotten powers have turned it into dust and ruin.\nEven the
    creatures here have changed."
  - 'The slimes that roam this wasteland are made from hardened earth and sand.

    They
    are tougher than those you faced in the forest.

    Be careful, little wanderer.
    Learn how this land fights back.'
  relatedQuest: {fileID: 11400000, guid: 1742e96b9f8fdaa47a00f494dcba0a17, type: 2}
  questState: 1
  startQuestOnEnd: 0
